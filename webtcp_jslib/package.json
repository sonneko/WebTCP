{
  "name": "@sonneko/webtcp-tunneler",
  "version": "0.1.0",
  "description": "Experimental virtual TCP/HTTP tunnel over WebRTC data channels",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc",
    "test": "npm run build && node --test tests/*.test.mjs",
    "demo": "node ../examples/server.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sonneko/WebTCP.git"
  },
  "keywords": [
    "p2p",
    "webrtc",
    "web3",
    "tcp",
    "tunnel"
  ],
  "author": "sonneko",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/sonneko/WebTCP/issues"
  },
  "homepage": "https://github.com/sonneko/WebTCP#readme",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
